# /etc/opengym.env, root:opengym 0640. Read by opengym.service.
RP_ID=fit.slippylabs.com
ORIGIN=https://fit.slippylabs.com
RP_NAME=openGym
# Open sign-up with passkeys, and name + password for anyone without one.
PASSWORD_LOGIN=1
INVITE_ONLY=0
ALLOW_GUEST=1
# nginx sets X-Forwarded-For to the real client (Cloudflare real-ip is configured).
TRUST_PROXY=1
# Never "first sign-up is admin" on a public instance: set the owner's uid here once they exist.
FIRST_USER_ADMIN=0
ADMIN_UIDS=
VAPID_SUBJECT=https://fit.slippylabs.com
# Sign in with a slippylabs.com account: nginx passes the name on /api/sso/* only (see the vhost).
SSO_HEADER=X-SSO-User
